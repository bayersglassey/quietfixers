https://stackoverflow.com/a/69308048

    # outputs e.g. /sys/class/input/input4/capabilities/key
    ls -d1 /sys/class/input/input*/capabilities/key | while read dev; do
        KEY="$(cat $dev | rev | cut -d ' ' -f 1 | rev)"
        [ $(( (0x$KEY & 0x7f07fc3ff0000) == 0x7f07fc3ff0000 )) == 1 ] && echo $dev
    done



